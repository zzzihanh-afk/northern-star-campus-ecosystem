# ==============================================================================
# NORTHERN STAR SMART CAMPUS - WEB APPLICATION ENVIRONMENT VARIABLES
# ==============================================================================

# Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
# Example: https://xyzcompanyref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon/Public API Key (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Default Institutional Tenant UUID (Northern Star School & College)
NEXT_PUBLIC_DEFAULT_INSTITUTION_ID=a0000000-0000-0000-0000-000000000001
